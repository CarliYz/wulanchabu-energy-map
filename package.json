{
  "name": "energy-map-workbench",
  "version": "0.3.0-rc.3",
  "private": true,
  "type": "module",
  "scripts": {
    "qa": "playwright test",
    "qa:headed": "playwright test --headed",
    "qa:report": "playwright show-report",
    "qa:mcp": "node qa/mcp-server.mjs",
    "qa:mcp:smoke": "node qa/mcp-smoke.mjs",
    "test": "node --test tests/*.test.mjs",
    "qa:current": "npm --prefix qa/agent-e2e test -- --config e2e.closeout.config.js"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/mcp": "0.0.85",
    "@playwright/test": "1.65.1"
  }
}
