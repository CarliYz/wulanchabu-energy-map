{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://energy.local/contracts/common.schema.json",
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_:-]*$"
    },
    "phase": {
      "enum": [
        "existing_context",
        "concept",
        "p1_candidate",
        "p2_candidate",
        "future_candidate"
      ]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "locator": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "nature": {
          "enum": [
            "planning",
            "model_audit",
            "schematic",
            "synthetic",
            "measured"
          ]
        }
      },
      "required": [
        "path",
        "locator",
        "sha256",
        "nature"
      ]
    },
    "vec3": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 3,
      "maxItems": 3
    },
    "position": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "space": {
          "enum": [
            "local_utm_z_up",
            "object_local_z_up"
          ]
        },
        "xyz_m": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 3,
              "maxItems": 3
            },
            {
              "type": "null"
            }
          ]
        },
        "status": {
          "enum": [
            "schematic",
            "unknown",
            "surveyed"
          ]
        }
      },
      "required": [
        "space",
        "xyz_m",
        "status"
      ]
    }
  }
}
